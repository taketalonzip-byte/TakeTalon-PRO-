# TakeTalon PRO - Environment Variables
# Copy this file to .env or configure these variables in your hosting environment / secrets manager.

# Gemini AI API Key (Server-side AI predictions and analysis)
GEMINI_API_KEY=

# Public Application URL
APP_URL=http://localhost:3000

# Supabase Configuration (Database, Auth, and Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_PASSWORD=your-database-password

# Session Security Secret
SESSION_SECRET=your-session-secret-here

# SMS Gateway Webhook Secret Keys
SMS_SECRET_KEY=your-secret-key-here
SMS_FORWARDER_SECRET=your-secret-key-here
